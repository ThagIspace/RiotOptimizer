<Page x:Class="ValorantResFix.Home"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ValorantResFix"
      mc:Ignorable="d" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      TextElement.Foreground="{DynamicResource MaterialDesignBody}"
      TextElement.FontWeight="Regular"
      TextElement.FontSize="13"
      TextOptions.TextFormattingMode="Ideal"
      TextOptions.TextRenderingMode="Auto"
      Background="#FF151515"
      FontFamily="{DynamicResource MaterialDesignFont}"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Home">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

            <StackPanel Orientation="Horizontal" Margin="0 10 0 0" HorizontalAlignment="Center">
                <StackPanel VerticalAlignment="Center">
                    <materialDesign:PackIcon HorizontalAlignment="Center" Kind="FileCog" Width="40" Height="40"></materialDesign:PackIcon>
                    <TextBlock Name="TotalAccountsLbl" Margin="5" Opacity="0.8" FontWeight="SemiBold" HorizontalAlignment="Center">Tổng số tài khoản</TextBlock>
                    <TextBlock Name="TotalFileTxt" FontSize="28" HorizontalAlignment="Center" FontWeight="Bold">00</TextBlock>
                </StackPanel>
                
                <!-- Left Column Settings -->
                <Grid Margin="18 0 0 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="75"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Margin="5" VerticalAlignment="Center" FontWeight="SemiBold" Opacity="0.85" Grid.Row="0" Grid.Column="0">Resolution Quality (0 - 100)</TextBlock>
                    <TextBlock Margin="5" VerticalAlignment="Center" FontWeight="SemiBold" Opacity="0.85" Grid.Row="1" Grid.Column="0">View Distance Quality (0 - 3)</TextBlock>
                    <TextBlock Margin="5" VerticalAlignment="Center" FontWeight="SemiBold" Opacity="0.85" Grid.Row="2" Grid.Column="0">Anti-Aliasing Quality (0 - 3)</TextBlock>
                    <TextBlock Margin="5" VerticalAlignment="Center" FontWeight="SemiBold" Opacity="0.85" Grid.Row="3" Grid.Column="0">Shadow Quality (0 - 3)</TextBlock>
                    <TextBlock Margin="5" VerticalAlignment="Center" FontWeight="SemiBold" Opacity="0.85" Grid.Row="4" Grid.Column="0">Post-Process Quality (0 - 3)</TextBlock>
                    <TextBlock Margin="5" VerticalAlignment="Center" FontWeight="SemiBold" Opacity="0.85" Grid.Row="5" Grid.Column="0">Global Illumination (0 - 3)</TextBlock>

                    <TextBox Name="ResqualityBox" Grid.Row="0" BorderThickness="1.5" BorderBrush="LightSkyBlue" Grid.Column="1" Width="70" HorizontalAlignment="Left" Margin="4 0 0 0" VerticalAlignment="Center"></TextBox>
                    <TextBox Name="ViewDistanceQBox" Grid.Row="1" BorderThickness="1.5" BorderBrush="LightSkyBlue" Grid.Column="1" Width="70" HorizontalAlignment="Left" Margin="4 0 0 0" VerticalAlignment="Center"></TextBox>
                    <TextBox Name="AntiAliasisBox" Grid.Row="2" BorderThickness="1.5" BorderBrush="LightSkyBlue" Grid.Column="1" Width="70" HorizontalAlignment="Left" Margin="4 0 0 0" VerticalAlignment="Center"></TextBox>
                    <TextBox Name="ShadowQBox" Grid.Row="3" BorderThickness="1.5" BorderBrush="LightSkyBlue" Grid.Column="1" Width="70" HorizontalAlignment="Left" Margin="4 0 0 0" VerticalAlignment="Center"></TextBox>
                    <TextBox Name="PostProcessBox" Grid.Row="4" BorderThickness="1.5" BorderBrush="LightSkyBlue" Grid.Column="1" Width="70" HorizontalAlignment="Left" Margin="4 0 0 0" VerticalAlignment="Center"></TextBox>
                    <TextBox Name="GIQualityBox" Grid.Row="5" BorderThickness="1.5" BorderBrush="LightSkyBlue" Grid.Column="1" Width="70" HorizontalAlignment="Left" Margin="4 0 0 0" VerticalAlignment="Center"></TextBox>
                </Grid>

                <!-- Right Column Settings -->
                <Grid Margin="18 0 0 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="195"/>
                        <ColumnDefinition Width="75"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Margin="5" VerticalAlignment="Center" FontWeight="SemiBold" Opacity="0.85" Grid.Row="0" Grid.Column="0">Texture Quality (0 - 3)</TextBlock>
                    <TextBlock Margin="5" VerticalAlignment="Center" FontWeight="SemiBold" Opacity="0.85" Grid.Row="1" Grid.Column="0">Effects Quality (0 - 3)</TextBlock>
                    <TextBlock Margin="5" VerticalAlignment="Center" FontWeight="SemiBold" Opacity="0.85" Grid.Row="2" Grid.Column="0">Foliage Quality (0 - 3)</TextBlock>
                    <TextBlock Margin="5" VerticalAlignment="Center" FontWeight="SemiBold" Opacity="0.85" Grid.Row="3" Grid.Column="0">Shading Quality (0 - 3)</TextBlock>
                    <TextBlock Margin="5" VerticalAlignment="Center" FontWeight="SemiBold" Opacity="0.85" Grid.Row="4" Grid.Column="0">Reflection Quality (0 - 3)</TextBlock>

                    <TextBox Name="TextureQBox" Grid.Row="0" BorderThickness="1.5" BorderBrush="LightSkyBlue" Grid.Column="1" Width="70" HorizontalAlignment="Left" Margin="4 0 0 0" VerticalAlignment="Center"></TextBox>
                    <TextBox Name="EffectQBox" Grid.Row="1" BorderThickness="1.5" BorderBrush="LightSkyBlue" Grid.Column="1" Width="70" HorizontalAlignment="Left" Margin="4 0 0 0" VerticalAlignment="Center"></TextBox>
                    <TextBox Name="FoliageQBox" Grid.Row="2" BorderThickness="1.5" BorderBrush="LightSkyBlue" Grid.Column="1" Width="70" HorizontalAlignment="Left" Margin="4 0 0 0" VerticalAlignment="Center"></TextBox>
                    <TextBox Name="ShadingQBox" Grid.Row="3" BorderThickness="1.5" BorderBrush="LightSkyBlue" Grid.Column="1" Width="70" HorizontalAlignment="Left" Margin="4 0 0 0" VerticalAlignment="Center"></TextBox>
                    <TextBox Name="ReflectionQBox" Grid.Row="4" BorderThickness="1.5" BorderBrush="LightSkyBlue" Grid.Column="1" Width="70" HorizontalAlignment="Left" Margin="4 0 0 0" VerticalAlignment="Center"></TextBox>
                </Grid>
            </StackPanel>

            <!-- Guidelines / Scale Hint Banner -->
            <Border Background="#FF1E1E1E" CornerRadius="4" Padding="14 6" Margin="0 14 0 0" HorizontalAlignment="Center">
                <TextBlock Name="ValScaleHintTxt" Text="• Mức đồ họa: 0 = Thấp nhất (Low), 1 = Trung bình, 2 = Cao, 3 = Tối đa (Ultra) | Độ phân giải: 0 - 100%" Foreground="#87CEFA" FontSize="11.5" FontWeight="SemiBold"/>
            </Border>

            <!-- Action Buttons -->
            <StackPanel Margin="0 25 0 0" HorizontalAlignment="Center" Orientation="Horizontal">
                <Button Name="SaveBtn" Click="SaveBtn_Click" Width="140" Margin="6" ToolTip="Lưu thiết lập vào tất cả tài khoản">Lưu thay đổi</Button>
                <Button Name="ApplyLowBtn" Click="ApplyLowBtn_Click" Width="180" Margin="6" ToolTip="Cài đặt cấu hình thấp nhất để tối đa hóa FPS">Tối ưu FPS (Low)</Button>
                <Button Name="resDefBtn" Click="resDefBtn_Click" Width="190" Margin="6" Style="{DynamicResource MaterialDesignOutlinedButton}" Foreground="LightCoral" BorderBrush="LightCoral" ToolTip="Khôi phục các file có bản sao lưu và mở khóa file">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Restore" VerticalAlignment="Center" Margin="0 0 6 0"/>
                        <TextBlock Name="ResDefBtnText" Text="Khôi phục bản sao lưu" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <Button Name="BrowseBtn" Click="BrowseBtn_Click" HorizontalAlignment="Center" Margin="0 4 0 0"
                    Style="{DynamicResource MaterialDesignOutlinedButton}">Chọn file...</Button>

            <StackPanel Margin="5" Name="LoadGrid">
                <TextBlock Name="LoadTxt" HorizontalAlignment="Center" FontWeight="SemiBold">Đang tải dữ liệu, vui lòng đợi...</TextBlock>
                <ProgressBar Margin="5" IsIndeterminate="True" Width="280"></ProgressBar>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
